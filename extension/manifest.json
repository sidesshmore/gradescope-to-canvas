{
  "manifest_version": 3,
  "name": "Gradescope to Canvas Quiz Copier",
  "version": "0.1.0",
  "description": "Copy a multiple-choice quiz (questions, answer key, points, math, figures) from a Gradescope rubric page into a Canvas classic quiz. Runs in your own browser session; nothing is sent to any server.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Gradescope to Canvas Quiz Copier",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://www.gradescope.com/*",
    "https://production-gradescope-uploads.s3-us-west-2.amazonaws.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.gradescope.com/courses/*/assignments/*/rubric/edit*"],
      "js": ["lib/ui.js", "lib/tex-code.js", "lib/extract-gradescope.js", "lib/validate.js", "content/gradescope.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://canvas.asu.edu/courses/*/quizzes/*/edit*",
        "https://*.instructure.com/courses/*/quizzes/*/edit*"
      ],
      "js": ["lib/ui.js", "lib/validate.js", "lib/import-canvas.js", "lib/canvas-files.js", "content/canvas.js"],
      "run_at": "document_idle"
    }
  ]
}
